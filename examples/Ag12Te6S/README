python3.8 phonon_self_energy.py --qpath "0,0,0 0.5,0,0 0.333,0.333,0 0,0,0 0,0,0.5" --labels "Gamma M K Gamma A" --npoints 50 --scale-self-energy 1.0 --out-dir output_T300K_test --temp 300 --broadening 0.0 --min-broadening 1.0 --wgrid-points 2000

cd output_T300K_test
use the plotting scripts
